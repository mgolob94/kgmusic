# ── Lokalni razvoj (npm run dev) ──
DATABASE_URL=postgres://kgmusic:kgmusic@localhost:5432/kgmusic

# ── Skupno ──
# Dolgo naključen niz: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string

# Račun učiteljice – ustvari se ob prvem zagonu (migrate skripta)
ADMIN_EMAIL=ucitelj@example.com
ADMIN_PASSWORD=zamenjaj-me-12345

# "false" samo pri testiranju prek http (brez HTTPS), sicer prijava ne deluje
COOKIE_SECURE=true

# ── Samo docker-compose na strežniku ──
POSTGRES_PASSWORD=zamenjaj-me
