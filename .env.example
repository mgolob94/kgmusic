# Povezava na bazo (lokalno: docker compose up db)
DATABASE_URL=postgres://kgmusic:kgmusic@localhost:5432/kgmusic

# Dolgo naključen niz (npr. `openssl rand -base64 48`)
SESSION_SECRET=change-me-to-a-long-random-string

# Račun učiteljice – ustvari se ob prvem zagonu (migrate skripta)
ADMIN_EMAIL=ucitelj@example.com
ADMIN_PASSWORD=zamenjaj-me-12345

# Nastavi na "false" samo če testiraš prek http (brez HTTPS)
COOKIE_SECURE=true
