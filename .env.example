# ── Lokalni razvoj (npm run dev) ──
DATABASE_URL=postgres://kgmusic:kgmusic@localhost:5432/kgmusic

# ── Skupno ──
# Dolgo naključen niz: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string

# Registracija: uporabniki si ustvarijo račun na /registracija.
# INVITE_CODE (priporočeno na javnem strežniku): brez kode se nihče ne more registrirati.
# REGISTRATION_OPEN=false: registracija povsem zaprta.
REGISTRATION_OPEN=true
INVITE_CODE=

# Neobvezno: račun, ustvarjen ob zagonu (migrate skripta), če še ne obstaja
ADMIN_EMAIL=
ADMIN_PASSWORD=

# "false" samo pri testiranju prek http (brez HTTPS), sicer prijava ne deluje
COOKIE_SECURE=true

# ── Samo docker-compose na strežniku ──
POSTGRES_PASSWORD=zamenjaj-me
