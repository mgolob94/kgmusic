# /etc/nginx/sites-available/kgmusic  →  ln -s v sites-enabled
# Najprej samo HTTP; nato: sudo certbot --nginx -d kgmusic.example.com
# Certbot sam doda blok za 443 s certifikatom in preusmeritev iz 80 na HTTPS.
server {
    listen 80;
    listen [::]:80;
    server_name kgmusic.example.com;

    client_max_body_size 2m;

    location / {
        proxy_pass http://127.0.0.1:3009;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
